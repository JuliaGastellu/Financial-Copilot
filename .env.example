# Copio este archivo a .env para desarrollo local. No guardo claves reales en el repositorio.
# Los nombres coinciden con los campos de app/core/config.py (Settings), salvo POSTGRES_PASSWORD (Compose).

ENVIRONMENT=local

# Con OFFLINE_MODE=true no llamo al proveedor aunque exista una clave.
OFFLINE_MODE=true
# OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Sin DATABASE_URL uso SQLite en DATA_DIR/app.db (solo local y test). Producción exige PostgreSQL.
DATA_DIR=./data
# DATABASE_URL=postgresql+psycopg://copilot:<password>@127.0.0.1:5432/copilot
# POSTGRES_PASSWORD=
# CHROMA_DIR=./data/chroma

# Identidad. Para desarrollo genero claves con: python scripts/dev_identity.py init
OIDC_ISSUER=http://127.0.0.1/dev-issuer
OIDC_AUDIENCE=financial-copilot-local
OIDC_JWKS_URL=file:data/dev_identity/jwks.json
# En producción uso https para OIDC_ISSUER y OIDC_JWKS_URL, y defino PRIVACY_HASH_KEY (32+ caracteres).
# PRIVACY_HASH_KEY=

# Lista JSON de orígenes permitidos.
ALLOWED_ORIGINS=["http://127.0.0.1:8000"]

RATE_LIMIT_ENABLED=true

# Explicación de planes con un proveedor de texto. Deshabilitada por defecto: el plan no depende de ella.
EXPLANATION_PROVIDER=disabled
# EXPLANATION_MODEL=gpt-4o-mini
# EXPLANATION_DAILY_QUOTA=20
