# Copio este archivo a .env para desarrollo local. No guardo claves reales en el repositorio.
# Los nombres coinciden con los campos de app/core/config.py (Settings).

ENVIRONMENT=local

# Con OFFLINE_MODE=true no llamo al proveedor aunque exista una clave.
OFFLINE_MODE=true
# OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Si omito SQLITE_PATH y CHROMA_DIR, uso DATA_DIR/app.db y DATA_DIR/chroma.
DATA_DIR=./data
# SQLITE_PATH=./data/app.db
# CHROMA_DIR=./data/chroma

# Lista JSON de orígenes permitidos.
ALLOWED_ORIGINS=["http://127.0.0.1:8000"]

RATE_LIMIT_ENABLED=true
